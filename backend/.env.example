GROQ_API_KEY=your-groq-api-key-here
# Get a free key from https://console.groq.com/keys

PEXELS_API_KEY=your-pexels-api-key-here
# Get a free key (no card required) from https://www.pexels.com/api/

# llama-3.3-70b-versatile / llama-3.1-8b-instant have been retired from Groq's
# lineup; openai/gpt-oss-120b and openai/gpt-oss-20b are the current large/small
# pair. If these stop working, run client.models.list() against your key or
# check https://console.groq.com/docs/models -- providers retire names often.
# Note: Groq's free-tier daily token quota is PER MODEL, not per account. If
# PLANNING_MODEL's quota runs out mid-hackathon, swapping to another chat
# model on the list (e.g. qwen/qwen3.8-27b) gives you a completely separate,
# fresh quota bucket instead of waiting -- just confirm it handles strict
# json_schema mode cleanly first (some "thinking" models emit a <think>
# preamble that breaks JSON parsing; qwen3.6 does this, qwen3.8 doesn't).
GROQ_PLANNING_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b

EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
